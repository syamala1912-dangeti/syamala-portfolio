    </section>

    <!-- CONTACT -->
    <section id="contact">
        <h2 class="section-title">Contact Me</h2>

        <div class="contact">
            <p>
                Interested in connecting with me? Feel free to reach out.
            </p>

            <a href="mailto:your-email@example.com" class="btn">
                Email Me
            </a>
        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <p>© 2026 Syamala Dangeti. All Rights Reserved.</p>
    </footer>

</body>
</html>
