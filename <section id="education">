/* EDUCATION */
.education {
    max-width: 750px;
    margin: auto;
}

.education-item {
    border-left: 2px solid #8b5cf6;
    padding: 5px 0 25px 25px;
    position: relative;
}

.education-item::before {
    content: "";
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #8b5cf6;
    position: absolute;
    left: -6px;
    top: 9px;
}

.education-item h3 {
    margin-bottom: 5px;
}

.education-item p {
    color: #aaa;
}


/* CONTACT */
.contact-box {
    max-width: 750px;
    margin: auto;
    text-align: center;
    background: linear-gradient(
        135deg,
        rgba(139, 92, 246, 0.13),
        rgba(79, 70, 229, 0.08)
    );
    border: 1px solid rgba(139, 92, 246, 0.25);
    border-radius: 25px;
    padding: 50px 30px;
}

.contact-box h2 {
    font-size: 34px;
    margin-bottom: 15px;
}

.contact-box p {
    color: #aaa;
    margin-bottom: 25px;
}

.contact-links {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
}

.contact-link {
    padding: 11px 20px;
    border: 1px solid #444;
    border-radius: 25px;
    color: #ddd;
    transition: 0.3s;
}

.contact-link:hover {
    border-color: #b88cff;
    color: #b88cff;
}
